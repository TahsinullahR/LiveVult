{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"livevult",
  "main":"src/worker.ts",
  "compatibility_date":"2026-10-30",
  "assets":{"directory":"./dist","binding":"ASSETS","not_found_handling":"single-page-application"},
  "r2_buckets":[{"binding":"FILES","bucket_name":"livevult-files"}],
  "d1_databases":[{"binding":"DB","database_name":"livevult-db","database_id":"REPLACE_WITH_D1_DATABASE_ID"}]
}